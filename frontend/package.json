{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "prettify": "prettier --log-level warn --cache --write '{src/**/*,*}.{ts,tsx,js,json,scss,yml}' '!**/{node_modules,dist}/**/*'",
    "gen:api": "pnpm dlx openapi-typescript http://localhost:8000/openapi.json -o src/api/schema.d.ts",
    "bdev": "cd .. && ./.venv/bin/uvicorn app.main:app --app-dir backend --reload --port 8000"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.105.3",
    "axios": "^1.21.0",
    "classnames": "^2.5.1",
    "lucide-react": "^1.64.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-dropzone": "^20.1.4",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "reset-css": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "sass-embedded": "^1.107.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5"
  }
}
